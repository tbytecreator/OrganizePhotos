# Variáveis de Ambiente para Docker Compose
# Copie este arquivo para .env e customize os caminhos conforme necessário

# Diretório de origem (onde estão as fotos para organizar)
# Use caminho absoluto ou relativo
SOURCE_DIR=~/Pictures
# Diretório de saída (onde as fotos organizadas serão salvas)
# Use caminho absoluto ou relativo
OUTPUT_DIR=~/PicturesByDate